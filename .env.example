# 이 파일을 복사해 .env 파일을 만들고 실제 값을 넣으세요.
# .env는 깃(GitHub)에 올라가지 않습니다. API 키를 절대 공유하거나 커밋하지 마세요.
# 배포할 때는 Vercel 프로젝트 설정 > Environment Variables에 같은 이름으로 넣습니다.
# 값은 따옴표 없이 = 뒤에 바로 붙여 넣으세요.
# 키를 모두 비워 두면 AI를 부르지 않고 "준비 중" 답변이 나옵니다.

# ── 기본: Groq (무료 요금제, console.groq.com 에서 발급) ──
GROQ_API_KEY=
# (선택) 사용할 모델. 비워 두면 openai/gpt-oss-120b
GROQ_MODEL=

# ── 예비: Claude (유료, console.anthropic.com 에서 발급) ──
# GROQ_API_KEY가 비어 있을 때만 사용됩니다.
ANTHROPIC_API_KEY=
# (선택) 사용할 Claude 모델. 비워 두면 claude-opus-5-5
CLAUDE_MODEL=
